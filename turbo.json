{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "tsconfig.base.json",
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "REDIS_URL",
    "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING",
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "PRISMA_CLI_BINARY_TARGETS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "*.tsbuildinfo"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "src/**",
        "test/**",
        "package.json"
      ]
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "eval": {
      "cache": false,
      "dependsOn": [
        "^build"
      ]
    },
    "seed": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    }
  }
}
