# ─────────────────────────────────────────────────────────────────────────────
# AutoCreator AI — Worker image (AWS ECR → ECS Fargate)
# Consumes BullMQ queues (generation/image-generation/dubbing/publish/render/
# thumbnail), runs FFmpeg renders, campaign scheduler, DLQ writer.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
ENV NODE_ENV=production
# Prisma generation and runtime must agree on the system OpenSSL ABI. The slim
# Node image does not guarantee libssl is installed, so install it in the shared
# base used by both builder and runner. ca-certificates is also required for
# outbound HTTPS calls to the AI video providers.
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable \
 && corepack prepare pnpm@9.15.9 --activate

FROM base AS builder
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json prisma.config.ts ./
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/logger/package.json ./packages/logger/
COPY packages/database/package.json ./packages/database/
COPY packages/auth/package.json ./packages/auth/
COPY packages/events/package.json ./packages/events/
COPY packages/video-engine/package.json ./packages/video-engine/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/

# Build stage needs devDependencies (Prisma CLI, TypeScript, etc.) even though
# the final runtime uses NODE_ENV=production.
RUN pnpm install --no-frozen-lockfile --ignore-scripts --prod=false

COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY infra ./infra

RUN openssl version && pnpm --filter @aca/database exec prisma generate --schema prisma/schema.prisma
RUN pnpm --filter @aca/shared build \
 && pnpm --filter @aca/config build \
 && pnpm --filter @aca/logger build \
 && pnpm --filter @aca/database build \
 && pnpm --filter @aca/auth build \
 && pnpm --filter @aca/events build \
 && pnpm --filter @aca/video-engine build \
 && pnpm --filter @aca/api build \
 && pnpm --filter @aca/worker build

FROM base AS runner
WORKDIR /app
ENV PORT=8080 HOST=0.0.0.0

# FFmpeg/ffprobe binaries from the npm packages (kept in node_modules)
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma
COPY --from=builder /app/infra/fonts ./infra/fonts

# Validate the final stage, not just the builder where pnpm links always exist.
RUN openssl version \
 && cd /app/apps/worker \
 && node --input-type=module -e \
  "const {createRequire}=await import('node:module'); const require=createRequire(import.meta.url); const p=JSON.parse(await (await import('node:fs/promises')).readFile('package.json','utf8')); for (const dependency of Object.keys(p.dependencies)) { try { import.meta.resolve(dependency) } catch (error) { if (error.code !== 'ERR_PACKAGE_PATH_NOT_EXPORTED') require.resolve(dependency + '/package.json') } } await import('reflect-metadata'); console.log('Worker runtime dependencies verified')"

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

EXPOSE 8080
CMD ["node", "apps/worker/dist/main.js"]
