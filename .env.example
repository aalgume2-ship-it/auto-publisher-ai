# ─────────────────────────────────────────────────────────────────────────────
# AutoCreator AI — environment variable catalog (NAMES ONLY).
# Copy to .env.local and fill values locally. Real values NEVER enter git
# (enforced by gitleaks + CI boundary checks). See docs/Deployment.md §6.
#
# Managed services (Vercel-first architecture, Render removed):
#   DATABASE_URL → Neon (Postgres 16 + pgvector)
#   REDIS_URL    → Upstash Redis (Streams queue + rate limits + idempotency)
#   media blobs  → PostgreSQL AssetBlob table by default (durable); optional
#                  S3-compatible bucket or Vercel Blob via the S3_* vars
# ─────────────────────────────────────────────────────────────────────────────

# Core data plane
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_ASSETS=
S3_BUCKET_RENDERS=
S3_BUCKET_LOGS=

# CDN (media delivery)
CDN_PUBLIC_DOMAIN=
CDN_PRIVATE_DOMAIN=
CDN_SIGNING_KEY_PAIR_ID=
CDN_SIGNING_PRIVATE_KEY=

# Auth & crypto
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
KMS_KEY_ID=
SCIM_TOKEN_PEPPER=

# Email
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# Billing (IPaymentProvider adapters)
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AI providers (platform fallback keys; orgs may bring their own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_CREDENTIALS_JSON=
PEXELS_API_KEY=
PIXABAY_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Platform OAuth apps (channel connections)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# Event bus (streams now, kafka at scale stage B)
EVENTBUS_DRIVER=
KAFKA_BROKERS=

# Web/API runtime
WEB_APP_URL=
API_PUBLIC_URL=
PORT=

# Plugins isolation
PLUGIN_RPC_QUEUE=
PLUGIN_EGRESS_ALLOWLIST=
CLOUDFLARE_SAAS_API_TOKEN=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
JAEGER_ENDPOINT=
SENTRY_DSN=

# Worker/render tuning
RENDER_FFMPEG_THREADS=
RENDER_NODE_POOL=
# Optional ffmpeg/ffprobe binary overrides (default: bundled @ffmpeg-installer /
# @ffprobe-installer, then ffmpeg-static/ffprobe-static, then PATH)
FFMPEG_PATH=
FFPROBE_PATH=
# Local/attached-disk asset cache root (AssetStore; DB blobs are the durable copy)
ACA_STORAGE_DIR=

# Local-only extras (Mailpit/MinIO defaults are in docker-compose.yml)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# @aca/events backbone (packages/events)
EVENTS_REDIS_URL=redis://localhost:6379/0
EVENTS_SHARD_COUNT=64
EVENTS_STREAM_MAXLEN=1000000
EVENTS_RETRY_MAX_ATTEMPTS=
EVENTS_RETRY_BASE_MS=
EVENTS_RETRY_MAX_MS=
EVENTS_RELAY_BATCH=
EVENTS_RELAY_POLL_MS=
ACA_EVENTS_IT=
ACA_REDIS_URL=

# ── Lumen Studio — production wiring ──────────────────────────────────
# Serverless proxy upstream (server-side, never exposed to the browser).
API_UPSTREAM=
# Public API base (dev fallback).
NEXT_PUBLIC_API_BASE=
# Env-driven OAuth provider URLs (your Google/Apple OAuth endpoints).
NEXT_PUBLIC_GOOGLE_OAUTH_URL=
NEXT_PUBLIC_APPLE_OAUTH_URL=
