# ─────────────────────────────────────────────────────────────────────────────
# AutoCreator AI — environment variable catalog (NAMES ONLY — no real values).
# Copy to .env.local (local dev) or set in AWS Secrets Manager / Vercel env.
# NEVER commit real values (enforced by gitleaks + CI).
#
# Architecture (production):
#   Vercel  ──>  AWS ALB  ──>  ECS Fargate: apps/api (port 3000)
#                                   └─ apps/worker (port 8080, BullMQ consumer)
#   PostgreSQL  → AWS RDS   (migrate deploy, NOT db push)
#   Redis       → AWS ElastiCache
#   Storage     → AWS S3 (assets/renders/logs buckets)
#   Secrets     → AWS Secrets Manager
#   Logs        → CloudWatch
# ─────────────────────────────────────────────────────────────────────────────

# ── Core data plane (REQUIRED) ───────────────────────────────────────────
DATABASE_URL=            # postgresql://user:pass@host:5432/autocreator  (RDS)
REDIS_URL=               # redis://host:6379/0                            (ElastiCache)
REDIS_PREFIX=            # optional queue key prefix (default: aca)

# ── Storage (S3 — production). When unset, media falls back to Postgres AssetBlob ──
AWS_REGION=              # e.g. eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=               # assets bucket name (autocreator-<account>-assets)
S3_BUCKET_RENDERS=       # optional separate renders bucket
S3_BUCKET_LOGS=          # optional separate logs bucket
S3_ENDPOINT=             # S3-compatible endpoint (MinIO/R2) — optional
S3_PRESIGN_TTL_SEC=      # optional, default 7200

# ── Auth & crypto (REQUIRED in production) ───────────────────────────────
AUTH_JWT_SECRET=         # 64-hex random — run: openssl rand -hex 32
SECRETS_MASTER_KEY=      # 64-hex random — AES-256-GCM vault for org keys
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_ACCESS_TOKEN_TTL_SEC=
AUTH_REFRESH_TOKEN_TTL_SEC=
AUTH_TOTP_ENCRYPTION_KEY=

# ── AI providers (any LLM key enables the script stage; video/image keys unlock motion) ──
# LLM (script/translation — one key is enough)
OPENAI_API_KEY=
GROQ_API_KEY=            # free tier
GEMINI_API_KEY=          # free tier (Google AI Studio)
OPENROUTER_API_KEY=
POLLINATIONS_API_KEY=
# Video (moving clips — no free tier)
RUNWAY_API_KEY=
LUMA_API_KEY=
FAL_KEY=                 # fal.ai (Kling)
REPLICATE_API_TOKEN=
# Image
STABILITY_API_KEY=
# Voice
ELEVENLABS_API_KEY=
OPENAI_TTS_VOICE=

# ── Social OAuth (channel connections) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=   # https://api.yourdomain.com/v1/channels/oauth/youtube/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=   # https://api.yourdomain.com/v1/channels/oauth/tiktok/callback
META_APP_ID=             # Instagram (Meta Graph API)
META_APP_SECRET=

# ── Billing ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Public URLs ──────────────────────────────────────────────────────────
PUBLIC_API_URL=          # https://api.yourdomain.com   (AWS ALB)
PUBLIC_WEB_URL=          # https://your-app.vercel.app
PORT=                    # API: 3000, Worker: 8080
HOST=                    # 0.0.0.0
CORS_ORIGINS=            # comma-separated allowed origins (Vercel domain)

# ── Vercel (web) only ────────────────────────────────────────────────────
API_UPSTREAM=            # https://api.yourdomain.com — the ONLY upstream
NEXT_PUBLIC_API_BASE=    # dev fallback for the proxy

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=               # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=

# ── Worker/render tuning ─────────────────────────────────────────────────
ACA_STORAGE_DIR=         # local disk hot-cache root (S3/DB are the durable tier)
FFMPEG_PATH=             # optional override
FFPROBE_PATH=

# ── Local dev extras (never in production) ───────────────────────────────
SEED_ADMIN_ON_BOOT=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
