{
  "name": "@aca/api",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCreator AI \u2014 public HTTP API (NestJS 11 + Fastify 5): RFC 9457 errors, URI-versioned /v1 routes, generated OpenAPI, capability guards, idempotency, rate limits, OTel + Prometheus observability (L5).",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:integration": "ACA_API_IT=1 vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aca/config": "workspace:*",
    "@aca/database": "workspace:*",
    "@aca/events": "workspace:*",
    "@aca/logger": "workspace:*",
    "@aca/shared": "workspace:*",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-fastify": "^11.1.24",
    "@nestjs/swagger": "^8.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.7.2",
    "ioredis": "^5.4.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aca/typescript-config": "workspace:*",
    "@nestjs/testing": "^11.1.24",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
