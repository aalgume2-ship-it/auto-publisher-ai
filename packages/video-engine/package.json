{
  "name": "@aca/video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCreator AI video pipeline core: AI providers (LLM/TTS/image/video), durable asset store (S3 + Postgres blobs), FFmpeg render/compose, generation, image generation, dubbing, render/thumbnail jobs. Shared by the API (enqueue) and the worker (process).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aca/auth": "workspace:*",
    "@aca/config": "workspace:*",
    "@aca/database": "workspace:*",
    "@aca/logger": "workspace:*",
    "@aca/shared": "workspace:*",
    "@andresaya/edge-tts": "1.8.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffprobe-installer/linux-x64": "5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aca/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}