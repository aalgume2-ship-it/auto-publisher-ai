{
  "name": "@aca/shared",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCreator AI \u2014 the frozen public contracts (events, plugins, AI providers, ports, workflow) + platform constants. Zero workspace/vendor deps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js"
    },
    "./contracts/*.js": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js"
    },
    "./constants/*": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js"
    },
    "./constants/*.js": {
      "types": "./dist/constants/*.d.ts",
      "import": "./dist/constants/*.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./errors.js": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsc -b",
    "dev": "npx tsc -b --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fingerprint:update": "node ./scripts/update-fingerprint.mjs"
  },
  "dependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aca/typescript-config": "workspace:*",
    "vitest": "catalog:"
  }
}
