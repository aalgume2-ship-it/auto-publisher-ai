# ─────────────────────────────────────────────────────────────────────────────
# AutoCreator AI — API service image (AWS ECR → ECS Fargate)
# Production: runs on AWS Fargate behind an ALB; Postgres/RDS + Redis/ElastiCache
# + S3 are managed services (infra/aws/cloudformation.yml).
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
ENV NODE_ENV=production
# Prisma must see OpenSSL while generating and at runtime. Installing it in the
# shared base stage makes Prisma generate the matching Debian OpenSSL 3 engine
# and keeps the same libssl available in the final runner image.
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable \
 && corepack prepare pnpm@9.15.9 --activate

FROM base AS builder
WORKDIR /app

# Workspace manifests first (layer caching)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json prisma.config.ts ./
COPY packages/eslint-config/package.json ./packages/eslint-config/
COPY packages/typescript-config/package.json ./packages/typescript-config/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/logger/package.json ./packages/logger/
COPY packages/database/package.json ./packages/database/
COPY packages/auth/package.json ./packages/auth/
COPY packages/events/package.json ./packages/events/
COPY packages/video-engine/package.json ./packages/video-engine/
COPY apps/api/package.json ./apps/api/

# Build stage needs devDependencies (Prisma CLI, TypeScript, etc.) even though
# the final runtime uses NODE_ENV=production.
RUN pnpm install --no-frozen-lockfile --ignore-scripts --prod=false

# Sources
COPY packages ./packages
COPY apps/api ./apps/api
COPY infra ./infra

# Prisma generate + builds (real schema engine downloads at build time)
RUN openssl version && pnpm --filter @aca/database exec prisma generate --schema prisma/schema.prisma
RUN pnpm --filter @aca/shared build \
 && pnpm --filter @aca/config build \
 && pnpm --filter @aca/logger build \
 && pnpm --filter @aca/database build \
 && pnpm --filter @aca/auth build \
 && pnpm --filter @aca/events build \
 && pnpm exec tsc -b packages/video-engine/tsconfig.json --force \
 && grep -q 'ACA_BASE64_V1' packages/video-engine/dist/media/asset-store.js \
 && pnpm --filter @aca/api build

FROM base AS runner
WORKDIR /app
ENV PORT=3000 HOST=0.0.0.0

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma

# Fail the image build if pnpm package-level links or their shared-store targets
# were not copied into the final runtime stage.
RUN openssl version \
 && cd /app/apps/api \
 && node --input-type=module -e \
  "const {createRequire}=await import('node:module'); const require=createRequire(import.meta.url); const p=JSON.parse(await (await import('node:fs/promises')).readFile('package.json','utf8')); for (const dependency of Object.keys(p.dependencies)) { try { import.meta.resolve(dependency) } catch (error) { if (error.code !== 'ERR_PACKAGE_PATH_NOT_EXPORTED') require.resolve(dependency + '/package.json') } } await import('reflect-metadata'); console.log('API runtime dependencies verified')"

# Healthcheck for ECS target group
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

EXPOSE 3000
CMD ["node", "apps/api/dist/main.js"]
