{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks"
  },
  "deploy": {
    "startCommand": "node apps/api/dist/main.js",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "healthchecks": {
      "readiness": {
        "interval": 10,
        "timeout": 5,
        "path": "/v1/health/ready"
      },
      "liveness": {
        "interval": 30,
        "timeout": 5,
        "path": "/v1/health/live"
      }
    }
  }
}
