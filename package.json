{
  "name": "autocreator-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCreator AI \u2014 autonomous AI-native platform for YouTube/TikTok/Instagram channel operations",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "node infra/scripts/build.mjs",
    "lint": "turbo lint",
    "typecheck": "pnpm db:generate && turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e --concurrency=1",
    "eval": "turbo eval --filter @aca/ai",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "dev:bootstrap": "bash infra/scripts/dev-bootstrap.sh",
    "dev:api": "node infra/scripts/run-api.mjs",
    "dev:token": "node infra/scripts/mint-dev-token.mjs",
    "demo": "bash infra/scripts/demo-walkthrough.sh",
    "db:generate": "pnpm --filter @aca/database exec prisma generate",
    "db:migrate": "pnpm --filter @aca/database exec prisma migrate deploy",
    "db:dev": "pnpm --filter @aca/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @aca/database seed"
  },
  "devDependencies": {
    "@aca/eslint-config": "workspace:*",
    "@aca/typescript-config": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "prettier": "^3.4.2",
    "prisma": "catalog:",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.23.8",
      "handlebars": ">=4.7.9",
      "js-yaml": ">=4.3.0",
      "fast-uri": ">=3.1.2",
      "@fastify/static": ">=10.1.1",
      "@fastify/middie": ">=9.3.2",
      "find-my-way": ">=9.7.0",
      "lodash": ">=4.18.0",
      "protobufjs": ">=8.4.1",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.12"
    }
  }
}
